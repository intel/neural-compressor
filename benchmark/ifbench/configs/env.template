# IFBench evaluation configuration (Nemotron 3 Ultra-aligned defaults)
# Copy to <IFBench clone>/.env and fill in your endpoint + model.

# ---- API (OpenAI-compatible endpoint under test) ----
API_BASE=https://your-openai-compatible-endpoint/v1
API_KEY=your-api-key-here
MODEL=your-model-id

# ---- Generation parameters (aligned with Nemotron 3 Ultra IFBench recipe) ----
TEMPERATURE=1.0
TOP_P=0.95
# MAX_TOKENS<=0 means "do not send max_tokens" (use server default), matching
# Nemotron which removes max_tokens so long thinking output is not truncated.
MAX_TOKENS=0
ENABLE_THINKING=true
NUM_REPEATS=2
SEED=42

# ---- Benchmark parameters ----
INPUT_FILE=data/IFBench_test.jsonl
OUTPUT_FILE=data/responses.jsonl
WORKERS=8
# Per-request timeout (s) and retries, aligned with Nemotron (3600 / 10).
# The upstream default (600s) caused ~20/300 prompts to time out with thinking on.
REQUEST_TIMEOUT=3600
MAX_RETRIES=10
