# Reproducible dependency pins for agent benchmark environments.
# Update a pin only after rerunning the corresponding smoke tests.

# Standard vLLM release from PyPI.
VLLM_VERSION="${VLLM_VERSION:-0.26.0}"

# mini-SWE-agent release used by SWE-bench Verified.
MINI_SWE_AGENT_VERSION="${MINI_SWE_AGENT_VERSION:-2.4.6}"
SWEBENCH_VERSION="${SWEBENCH_VERSION:-4.1.0}"

# SWE-bench Pro V2 tasks, locked agents, and Docker network-policy support.
SWEBENCH_PRO_COMMIT="${SWEBENCH_PRO_COMMIT:-66f92766bba642462d4bbe5479e83f91f9211862}"
SWEBENCH_PRO_HARBOR_VERSION="${SWEBENCH_PRO_HARBOR_VERSION:-0.24.0}"
SWEBENCH_PRO_AGENT_VERSION="${SWEBENCH_PRO_AGENT_VERSION:-2.4.6}"

# MCP-Atlas repository and prebuilt sandbox image.
MCP_ATLAS_COMMIT="${MCP_ATLAS_COMMIT:-f24ba3fb0bfa484c86acb28431fad6d7282455f9}"
MCP_ATLAS_IMAGE="${MCP_ATLAS_IMAGE:-ghcr.io/scaleapi/mcp-atlas:1.2.7}"
MCP_ATLAS_NODE_VERSION="${MCP_ATLAS_NODE_VERSION:-20.19.4}"
