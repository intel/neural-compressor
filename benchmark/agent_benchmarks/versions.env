# Reproducible dependency pins for agent benchmark environments.
# Update a pin only after rerunning the corresponding smoke tests.

# Standard vLLM release from PyPI.
VLLM_VERSION="0.26.0"

# DeepSeek-V4-compatible vLLM fork.
DEEPSEEK_V4_VLLM_REPOSITORY="https://github.com/xin3he/vllm.git"
DEEPSEEK_V4_VLLM_COMMIT="1b6e277ac010fb3361369162c42d39b06d612e24"

# mini-SWE-agent release used by SWE-bench Verified.
MINI_SWE_AGENT_VERSION="2.4.6"

# SWE-bench Pro repository and its mini-SWE-agent submodule.
SWEBENCH_PRO_COMMIT="ca10a60a5fcae51e6948ffe1485d4153d421e6c5"
SWEBENCH_PRO_MINI_SWE_AGENT_COMMIT="d74716a3c8104a113f77cc9ab94cf407ecdcf1e9"

# MCP-Atlas repository and prebuilt sandbox image.
MCP_ATLAS_COMMIT="f24ba3fb0bfa484c86acb28431fad6d7282455f9"
MCP_ATLAS_IMAGE="ghcr.io/scaleapi/mcp-atlas:1.2.7"
MCP_ATLAS_NODE_VERSION="20.19.4"
